PORT=8000

# BLIP Configuration (Image Captioning)
# Set to false to disable BLIP and save memory (uses generic captions)
USE_BLIP=true
BLIP_MODEL=Salesforce/blip2-opt-2.7b

# SunoAPI Configuration (Music Generation)
USE_SUNO=true
SUNO_API_KEY=your_suno_api_key_here
SUNO_API_URL=https://api.sunoapi.org
SUNO_MODEL=V5

# Device Configuration (auto, cuda, cpu, mps)
DEVICE=auto

# Optional: override CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.com
