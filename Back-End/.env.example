# Server Configuration
PORT=8000

# AI Models
BLIP_MODEL=Salesforce/blip-image-captioning-large
MUSICGEN_MODEL=facebook/musicgen-small

# Feature Flags
USE_CLIP=false

# Device (auto, cuda, cpu, mps)
DEVICE=auto

# Database (opcional - usa SQLite local se não definido)
# Para PostgreSQL (DigitalOcean, Render, etc), use:
# DATABASE_URL=postgresql://user:password@host:port/dbname
# Exemplo DigitalOcean: postgresql://doadmin:PASSWORD@wavelength-db-do-user-xxxxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require
